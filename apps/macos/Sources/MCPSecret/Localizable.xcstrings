      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” diventa visibile all'agente in questo documento. Negli altri documenti resta mascherato finché non li re-indicizzi (Re-indicizza tutto)."
          }
        }
      }
